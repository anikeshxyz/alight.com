# ==============================================================================
# Alight International Multi-Vendor Marketplace - Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env for local overrides: `cp .env.example .env`
# 2. Never commit .env with real secrets to version control.
# ==============================================================================

# Application Profile & Ports
SPRING_PROFILES_ACTIVE=default
BACKEND_PORT=8080
BACKEND_URL=http://localhost:8080
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# PostgreSQL Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/alight_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=Aahankumar1@
DATABASE_DRIVER=org.postgresql.Driver

# Database Connection Pool (HikariCP)
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true

# Security & JSON Web Tokens (HMAC-SHA256 256-bit hex)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=86400000 # 24 Hours in ms
JWT_REFRESH_EXPIRATION=604800000 # 7 Days in ms

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Marketplace Business Policies
SETTLEMENT_HOLD_DAYS=7
COD_MAX_AMOUNT=10000

# Payment Gateway (Razorpay Sandbox/Production)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_wh_placeholder_secret

# Object Storage (S3 / Cloudinary for KYC & Product Media)
STORAGE_PROVIDER=local
STORAGE_UPLOAD_DIR=./uploads
# AWS_S3_BUCKET=alight-marketplace-media
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=ap-south-1
